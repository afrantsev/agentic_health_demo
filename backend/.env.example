# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter model slug (https://openrouter.ai/models). Must support tool calling and structured outputs.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional. Raises the PubMed rate limit from 3 to 10 req/s. https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Optional. Max reasoning/tool iterations per agent.
AGENT_MAX_ITER=6
